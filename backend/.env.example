# Copy this file to .env and fill in real values. Never commit .env.

# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/attendease

# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=480

# IANA timezone used to decide "today", e.g. Africa/Lagos, Europe/London
TIMEZONE=UTC
CURRENT_TERM=2026-Term1

# JSON list of allowed browser origins (only needed for a web frontend)
CORS_ORIGINS=[]

# Used by `python -m app.initial_data` to create the first admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
